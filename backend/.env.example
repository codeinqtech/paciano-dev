APP_NAME=Paciano
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Laragon (PACIANO-DEV.test on :8080) — or use 127.0.0.1:8000 with `php artisan serve`
APP_URL=http://PACIANO-DEV.test:8080/backend/public
MEDIA_URL=http://PACIANO-DEV.test:8080/backend/public

# Hero banner videos (optional — defaults to <project>/media/hero-videos next to backend/)
# HERO_VIDEO_PATH=
# HERO_VIDEO_URL=

# Contact page “Until We Meet” video (defaults: <project>/media/contact-video)
# Local (Laragon): stored under repo /media/contact-video, URL = site origin /media/contact-video
# CONTACT_VIDEO_PATH=C:/laragon/www/PACIANO-DEV/media/contact-video
# CONTACT_VIDEO_URL=http://PACIANO-DEV.test:8080/media/contact-video
# Staging (Hostinger — files under public_html/paciano/media/contact-video/):
# CONTACT_VIDEO_PATH=/home/.../public_html/paciano/media/contact-video
# CONTACT_VIDEO_URL=https://your-staging-domain.com/media/contact-video

# Upload limits (kilobytes for Laravel validation; defaults: images 2 MB, videos 50 MB)
# MEDIA_IMAGE_MAX_KB=2048
# MEDIA_VIDEO_MAX_KB=51200

# Google Places API (New) — fallback when Business Profile OAuth is not connected
# GOOGLE_PLACES_API_KEY=
# GOOGLE_PLACE_ID=ChIJ835SmFAR5DkRmylIBPB9QX4
# GOOGLE_PLACES_FIELD_MASK=id,displayName,rating,userRatingCount,reviews

# Google Business Profile (recommended for full reviews + profile photos + replies)
# OAuth client (Desktop/Web) with redirect = {APP_URL}/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/google/callback
# GOOGLE_BUSINESS_ACCOUNT_ID=109094720545726611610
# GOOGLE_BUSINESS_LOCATION_ID=7628622496311154039
# GOOGLE_BUSINESS_REVIEW_SCOPE=https://www.googleapis.com/auth/business.manage
# GOOGLE_REVIEWS_API_URL=https://mybusiness.googleapis.com/v4
# After OAuth (admin "Connect" or Postman), paste refresh token for CI/staging:
# GOOGLE_REFRESH_TOKEN=
# GOOGLE_BUSINESS_MAX_SYNC_PAGES=120

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=paciano
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@paciano.local"
MAIL_FROM_NAME="${APP_NAME}"

# OTP (optional — set test OTP for local dev without sending mail)
CHANGE_PASSWORD_TEST_OTP=
FORGOT_PASSWORD_TEST_OTP=

FRONTEND_URL=http://127.0.0.1:8443

SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1,127.0.0.1:8443,localhost:8443
